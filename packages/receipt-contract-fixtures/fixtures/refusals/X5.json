{
  "crossing": "X5",
  "callee": "expense receiveCompletedReceipt",
  "base": { "fixture": "S2-expense-receipt/all-recognized-gtin" },
  "cases": [
    { "name": "the payload as sent", "expect": "accepted" },
    { "name": "the same payload again, answered as already applied", "expect": "accepted", "after": "base" },
    { "name": "a resend that differs after apply, answered as already applied", "expect": "accepted", "after": "base", "set": { "receiptTotalCents": 1 } },
    { "name": "no line items", "expect": "refused", "set": { "lineItems": [] } },
    { "name": "a negative total", "expect": "refused", "set": { "receiptTotalCents": -1 } },
    { "name": "a quantity over the cap", "expect": "refused", "set": { "lineItems.0.quantity": 100001 } },
    { "name": "a currency that is not an ISO code", "expect": "refused", "set": { "currency": "US Dollars" } },
    { "name": "a receipt for another org, a wiring bug", "expect": "bug", "set": { "orgId": "another-org" } }
  ]
}
