{
  "crossing": "S1",
  "callee": "workflow-mapping ingestReceipt",
  "base": { "fixture": "S1-completed-receipt/single-item-recognized" },
  "cases": [
    { "name": "the payload as sent", "expect": "accepted" },
    { "name": "a lower-case currency, which the contract normalizes", "expect": "accepted", "set": { "currency": "usd" } },
    { "name": "a fractional quantity", "expect": "accepted", "set": { "lineItems.0.quantity": 6.002 } },
    { "name": "a resend that differs, answered with the stored receipt", "expect": "accepted", "after": "base", "set": { "vendorName": "Different" } },
    { "name": "a receipt for another org, a wiring bug", "expect": "bug", "status": 500, "message": "is not this org", "set": { "orgId": "another-org" } },
    { "name": "no receiptId", "expect": "refused", "status": 400, "message": "expected string, received undefined", "unset": ["receiptId"] },
    { "name": "an empty receiptId", "expect": "refused", "status": 400, "message": "expected string to have >=1 characters", "set": { "receiptId": "" } },
    { "name": "no line items", "expect": "refused", "status": 400, "message": "expected array to have >=1 items", "set": { "lineItems": [] } },
    { "name": "a negative tax", "expect": "refused", "status": 400, "message": "expected number to be >=0", "set": { "taxCents": -1 } },
    { "name": "a zero quantity", "expect": "refused", "status": 400, "message": "expected number to be >0", "set": { "lineItems.0.quantity": 0 } },
    { "name": "a submission time that is not ISO", "expect": "refused", "status": 400, "message": "Invalid ISO datetime", "set": { "submittedAt": "yesterday" } }
  ]
}
