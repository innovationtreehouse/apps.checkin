{
  "crossing": "X4",
  "callee": "local-inventory applyReceipt",
  "base": { "fixture": "S3-inventory-delta/recognized-only", "set": { "lineItems.0.isProvisional": false } },
  "cases": [
    { "name": "the payload as sent", "expect": "accepted" },
    { "name": "no retailer", "expect": "accepted", "unset": ["retailer"] },
    { "name": "the same delta again, answered as replayed", "expect": "accepted", "after": "base" },
    { "name": "a resend with a different delta", "expect": "refused", "status": 409, "message": "already applied with a different inventory delta", "after": "base", "set": { "lineItems.0.quantityDelta": 2 } },
    { "name": "a zero quantity", "expect": "refused", "status": 400, "message": "expected number to be >0", "set": { "lineItems.0.quantityDelta": 0 } },
    { "name": "a fractional quantity", "expect": "refused", "status": 400, "message": "expected int, received number", "set": { "lineItems.0.quantityDelta": 1.5 } },
    { "name": "an empty receiptId", "expect": "refused", "status": 400, "message": "at source.receiptId", "set": { "receiptId": "" } },
    { "name": "a blank orgId", "expect": "refused", "status": 400, "message": "at orgId", "set": { "orgId": "  " } },
    { "name": "a provisional line whose GTIN is outside the provisional range", "expect": "refused", "status": 400, "message": "Not a provisional Part ID", "set": { "lineItems.0.isProvisional": true } }
  ]
}
