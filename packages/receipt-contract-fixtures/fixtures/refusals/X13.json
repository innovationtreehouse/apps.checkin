{
  "crossing": "X13",
  "callee": "bulk-donation recordInKindDonor",
  "base": {
    "payload": {
      "orgId": "org-1",
      "receiptId": "R-1001",
      "donor": { "firstName": "Jane", "lastName": "Doe", "companyName": "Acme" },
      "seq": 2
    }
  },
  "cases": [
    { "name": "the payload as sent", "expect": "accepted" },
    { "name": "a donor with no company", "expect": "accepted", "set": { "donor.companyName": null } },
    { "name": "the same donor again", "expect": "accepted", "after": "base" },
    { "name": "an older sequence than one already seen, ignored", "expect": "accepted", "after": "base", "set": { "seq": 1, "donor.lastName": "Older" } },
    { "name": "a donor for another org", "expect": "refused", "set": { "orgId": "another-org" } },
    { "name": "an empty receiptId", "expect": "refused", "set": { "receiptId": "" } },
    { "name": "an empty first name", "expect": "refused", "set": { "donor.firstName": "" } },
    { "name": "an empty last name", "expect": "refused", "set": { "donor.lastName": "" } },
    { "name": "no company field at all", "expect": "refused", "unset": ["donor.companyName"] },
    { "name": "a negative sequence", "expect": "refused", "set": { "seq": -1 } },
    { "name": "a fractional sequence", "expect": "refused", "set": { "seq": 1.5 } }
  ]
}
