{
  "name": "@checkin/expense",
  "version": "0.0.0",
  "private": true,
  "library": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./pages/*": {
      "types": "./src/pages/*.tsx",
      "import": "./src/pages/*.tsx"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "import": "./src/components/*.tsx"
    },
    "./nav": {
      "types": "./src/nav.ts",
      "import": "./src/nav.ts"
    },
    "./qb-write": {
      "types": "./src/qb-write.ts",
      "import": "./src/qb-write.ts"
    }
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:deploy": "node --env-file=.env node_modules/.bin/prisma migrate deploy",
    "test": "vitest run",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@checkin/component-kit": "*",
    "@checkin/component-ui": "*",
    "@checkin/money": "*",
    "@checkin/pg-kit": "*",
    "@checkin/quickbooks": "*",
    "@checkin/receipt-types": "*",
    "@checkin/workflows": "*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "xstate": "^5.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@checkin/pg-test-harness": "*",
    "@checkin/receipt-contract-fixtures": "*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "dotenv": "^17.0.0",
    "prisma": "^7.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
