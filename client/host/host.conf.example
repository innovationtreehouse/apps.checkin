# Host settings for the kiosk. Read by systemd and by kioskctl: KEY=value only.
KIOSK_IMAGE=ghcr.io/innovationtreehouse/kiosk
KIOSK_RELEASE_TAG=kiosk-release
KIOSK_URGENT_TAG=kiosk-urgent
# Runs inside the container: kioskctl adds `docker exec kiosk-client`, so do not
# start this with docker. Must check local health only (database, proxy, scanner)
# and never the server, or an outage would roll back a good image.
# Updates refuse to run if this is empty. Quote the whole command; it splits on
# spaces, so no single argument may contain one.
KIOSK_HEALTH_CMD="python /app/healthcheck.py"
# Seconds a new container has to pass the health check.
KIOSK_HEALTH_TIMEOUT=90
