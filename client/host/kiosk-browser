#!/usr/bin/env bash
# Keeps Chromium on the kiosk page. Runs from Openbox autostart as the kiosk user.
MARKER=/var/lib/kiosk/.chromium-bounce
PORT=$(python3 -c "import json; print(json.load(open('/etc/kiosk/config.json')).get('listen_port', 8080))")

xset s noblank || true
xset s off || true
xset -dpms || true

# Newer Pi OS uses 'chromium', older uses 'chromium-browser'
if command -v chromium-browser >/dev/null; then
  CHROME=chromium-browser
else
  CHROME=chromium
fi

while true; do
  until (exec 3<>"/dev/tcp/localhost/$PORT") 2>/dev/null; do
    sleep 2
  done
  rm -f "$MARKER"
  "$CHROME" \
    --kiosk \
    --noerrdialogs \
    --disable-infobars \
    --no-first-run \
    --disable-session-crashed-bubble \
    --password-store=basic \
    "http://localhost:$PORT" &
  CHROME_PID=$!
  while kill -0 "$CHROME_PID" 2>/dev/null; do
    if [ -f "$MARKER" ]; then
      kill "$CHROME_PID" 2>/dev/null || true
      break
    fi
    sleep 2
  done
  wait "$CHROME_PID" 2>/dev/null
  sleep 2
done
