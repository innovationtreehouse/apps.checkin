{
  "name": "monitoring-relay-function",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run db:generate -w @checkin/monitoring-db && tsc --noEmit && node ../scripts/bundle-function.mjs",
    "typecheck": "tsc --noEmit",
    "run:once": "node --env-file=.env --import tsx src/cli.ts",
    "requeue-dead": "node --env-file=.env --import tsx src/cli.ts requeue-dead",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.700.0",
    "@checkin/monitoring-db": "*",
    "@checkin/telemetry": "*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@checkin/pg-test-harness": "*",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
