# Copy to .env (git-ignored) and fill in. See README.md "Configuration".
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:monitoring-alerts
MONITORING_DATABASE_URL=postgresql://user:password@localhost:5432/monitoring
# Required, no default. Must match the env the services push heartbeats under.
MONITORING_ENV=dev
