# Copy to .env (git-ignored) and fill in. See README.md "Where to put credentials".

# Connection string for a local Postgres.
SHOPIFY_READ_DATABASE_URL=postgresql://user:password@localhost:5432/shopify_read

# your-store.myshopify.com
SHOPIFY_SHOP=your-store.myshopify.com

# --- Admin API credentials: set ONE of the two options below ---

# Option A (local dev / legacy custom apps): a static Admin API access token
# (shpat_...). Used verbatim if set — takes precedence over the client id/secret
# below, and never expires from this process's point of view (Shopify's own ~24h
# expiry still applies, so re-fetch by hand when it lapses; see README "Getting the
# token").
# SHOPIFY_ADMIN_TOKEN=shpat_...

# Option B (deployed Lambda; also works locally): Dev Dashboard app Client ID +
# Client Secret. Leave SHOPIFY_ADMIN_TOKEN unset and the process mints its own
# short-lived (~24h) token via the client-credentials grant, caches it in memory,
# and re-mints automatically before it expires or if Shopify returns a 401 mid-run
# (#237). Never commit real values.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# API version to pin, e.g. 2025-07.
SHOPIFY_API_VERSION=2025-07

# Seed used ONLY by offline `inject` (defaults to SHOPIFY_SHOP). Real syncs derive
# store_id from the live store's myshopifyDomain instead.
# STORE_ID=

# ISO date — backfill starts here and moves forward.
CUTOVER_DATE=2025-01-01

# --- Monitoring heartbeat push (optional) ---
# Set MONITORING_DATABASE_URL to push run freshness to the monitoring DB. When it is
# set, MONITORING_ENV is required (no default): it must match the watchdog's. If it
# is missing, the sync runs without the push and logs an error.
# MONITORING_DATABASE_URL=postgresql://user:password@localhost:5432/monitoring
# MONITORING_ENV=dev
# SERVICE_NAME=shopify-read
