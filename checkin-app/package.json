{
  "name": "checkmein",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "eslint --max-warnings 0",
    "test": "jest --runInBand",
    "test:ci": "jest --ci --runInBand",
    "test:flow": "jest --config jest.flow.config.js --ci --runInBand --forceExit",
    "test:shopify-live": "jest --config jest.shopify-live.config.js --ci --runInBand",
    "test:flow:standalone": "export COMPOSE_PROJECT_NAME=flow-$(basename \"$(dirname \"$PWD\")\" | tr A-Z a-z | tr -cd a-z0-9_-); docker compose -f ../deploy/docker-compose.flow.yml up -d --wait --wait-timeout 600 && docker compose -f ../deploy/docker-compose.flow.yml exec -T app sh -lc \"cd checkin-app && npm run test:flow -- $FLOW_ARGS\"; ec=$?; [ $ec -eq 0 ] || docker compose -f ../deploy/docker-compose.flow.yml logs --no-color --tail 300 app; docker compose -f ../deploy/docker-compose.flow.yml down -v; exit $ec",
    "test:e2e": "playwright test",
    "test:e2e:standalone": "export COMPOSE_PROJECT_NAME=flow-$(basename \"$(dirname \"$PWD\")\" | tr A-Z a-z | tr -cd a-z0-9_-); docker compose -f ../deploy/docker-compose.flow.yml up -d --wait --wait-timeout 600 && docker compose -f ../deploy/docker-compose.flow.yml exec -T app sh -lc \"cd checkin-app && npx playwright install --with-deps chromium && npm run test:e2e -- $E2E_ARGS\"; ec=$?; [ $ec -eq 0 ] || docker compose -f ../deploy/docker-compose.flow.yml logs --no-color --tail 300 app; docker compose -f ../deploy/docker-compose.flow.yml down -v; exit $ec",
    "test:integration": "INTEGRATION_DB=1 jest --ci -w ${INTEGRATION_WORKERS:-1} --workerIdleMemoryLimit=1GB --testTimeout=60000 --testEnvironment=node --logHeapUsage --testPathIgnorePatterns=/node_modules/ --testRegex \"\\.integration\\.test\\.[jt]sx?$\"",
    "test:coverage": "INTEGRATION_DB=1 jest --ci --runInBand --coverage --testPathIgnorePatterns \"/node_modules/|/\\.next/|\\.flow\\.test\\.\"",
    "test:coverage:unit": "jest --ci --coverage --testPathIgnorePatterns \"/node_modules/|/\\.next/|\\.flow\\.test\\.|\\.integration\\.test\\.\"",
    "test:coverage:integration": "INTEGRATION_DB=1 jest --ci -w ${INTEGRATION_WORKERS:-1} --workerIdleMemoryLimit=1GB --testTimeout=60000 --coverage --testEnvironment=node --logHeapUsage --testPathIgnorePatterns=/node_modules/ --testRegex \"\\.integration\\.test\\.[jt]sx?$\"",
    "check-route-coverage": "ts-node --project scripts/tsconfig.json scripts/check-route-coverage.ts",
    "shopify:webhook": "tsx scripts/register-shopify-webhook.ts",
    "coalesce-migrations": "tsx scripts/coalesce-migrations.ts",
    "generate:lifecycle-artifacts": "tsx src/lib/lifecycle/generate.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-lambda": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@checkin/expense": "*",
    "@checkin/global-catalog": "*",
    "@checkin/bulk-donation": "*",
    "@checkin/income": "*",
    "@checkin/local-inventory": "*",
    "@checkin/money": "*",
    "@checkin/component-kit": "*",
    "@checkin/component-ui": "*",
    "@checkin/pg-kit": "*",
    "@checkin/quickbooks": "*",
    "@checkin/utils": "*",
    "@checkin/receipt": "*",
    "@checkin/receipt-types": "*",
    "@checkin/workflow-mapping": "*",
    "@checkin/s-ingest-core": "*",
    "@mantine/core": "^7.17.8",
    "@mantine/form": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/modals": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@react-pdf/renderer": "^4.3.2",
    "@tabler/icons-react": "^3.44.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "next": "16.4.3",
    "next-auth": "^4.24.13",
    "pdf-lib": "^1.17.1",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-qr-code": "^2.0.18",
    "resend": "^6.9.3",
    "svix": "^1.84.1"
  },
  "devDependencies": {
    "@jest/test-sequencer": "^30.3.0",
    "@playwright/test": "1.63.0",
    "@prisma/generator-helper": "7.8.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.0",
    "cross-fetch": "^4.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-fail-on-console": "^3.3.4",
    "jest-junit": "^17.0.0",
    "node-mocks-http": "^1.17.2",
    "prisma": "7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-morph": "^25.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
