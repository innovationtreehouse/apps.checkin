generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator security {
  provider = "node scripts/security-generator.js"
  output   = "../src/security/generated/classifications.ts"
}

datasource db {
  provider = "postgresql"
}

enum ToolLevel {
  BASIC
  DOF
  CERTIFIED
  INSTRUCTOR
  MAY_CERTIFY_OTHERS
}

enum RSVPStatus {
  ATTENDING
  NOT_ATTENDING
  NO_RESPONSE
  MAYBE
}

enum AuditAction {
  CREATE
  EDIT
  DELETE
  BECOME_ADMIN
}

/// How a visit arrival/departure was recorded. Five non-overlapping meanings
/// (docs/designs/1256_ATTENDANCE_CORRECTION_SURFACE.md, "Terminology"):
///   SCANNER        = physical kiosk badge — measured, exact.
///   TYPED          = a clock typed into a form (manual/dashboard entry) —
///                    asserted, not measured.
///   LEAD_MARKED    = staff asserted presence; a roster mark writes BOTH fields
///                    at the event window, so it is not arrival-only.
///   FACILITY_CLOSE = departure only; the building closed (last keyholder badged
///                    out) — stamped at the close moment, bounded by building hours.
///   AUTO_CLOSE     = departure only; the nightly cron swept an abandoned open
///                    visit — stamped at cron-run time, so the real leave may be
///                    hours earlier. Correcting one is expected by construction.
/// Domains: arrivedVia ∈ {SCANNER, TYPED, LEAD_MARKED};
///          departedVia ∈ {SCANNER, TYPED, LEAD_MARKED, FACILITY_CLOSE, AUTO_CLOSE}.
///
/// SYSTEM and WEB are retired. Each is kept in the type only so the previous
/// release can keep writing it through a rolling deploy's drain window; no
/// current code path writes either, and their backfill migrations left no rows
/// carrying them. Drop both in a follow-up release (contract stage).
enum VisitSource {
  SCANNER
  WEB
  TYPED
  LEAD_MARKED
  FACILITY_CLOSE
  AUTO_CLOSE
  SYSTEM
}

enum ProgramPhase {
  PLANNING
  UPCOMING
  RUNNING
  FINISHED
}

enum EnrollmentStatus {
  OPEN
  CLOSED
}

enum ProgramParticipantStatus {
  PENDING
  ACTIVE
}

model Person {
  /// @sensitivity:public
  id            Int       @id @default(autoincrement())
  /// @sensitivity:pii
  googleId      String?   @unique
  /// @sensitivity:pii
  email         String?   @unique
  /// @sensitivity:pii
  phone         String?
  /// @sensitivity:public
  name          String
  /// The name this person actually goes by. Printed on their badge in place of
  /// the first name parsed out of `name`; the last-name disambiguation still
  /// applies on top of it. Set by the person, a household lead, or a
  /// board/sysadmin printing badges. Same 'public' tier as `name` — it is worn
  /// on a badge.
  /// @sensitivity:public
  nickname      String?
  /// @sensitivity:internal
  emailVerified DateTime?
  /// @sensitivity:public
  image         String?
  accounts      Account[]
  sessions      Session[]

  /// DOB is intimate data, not contact data: 'personal' is the strict tier
  /// (self/household/board + explicit per-program grants), while 'pii' is the
  /// contact-identity band (email/phone) that program leads etc. may hold.
  /// @sensitivity:personal
  dateOfBirth          DateTime? @db.Date
  /// Set when a lead marks a member as 25+ without recording a DoB, so the
  /// member shows as "Adult" instead of "Age Unavailable". @sensitivity:internal
  isDeclaredAdult      Boolean   @default(false)
  /// @sensitivity:internal
  lastWaiverSign       DateTime?
  /// @sensitivity:internal
  waiverSignedBy       Int?
  /// @sensitivity:internal
  lastBackgroundCheck  DateTime? @db.Date
  /// Set when Resend reports a bounce/complaint for this person's address
  /// (webhooks/resend); cleared on a later `email.delivered` for the same
  /// address (self-healing). Role/audit metadata about deliverability, not the
  /// address itself. @sensitivity:internal
  emailUndeliverableAt DateTime?
  /// @sensitivity:personal
  notificationSettings Json?

  /// Self- or board-set suppression of outreach (join-invitation) email to this
  /// person. Set via the unsubscribe link (join-variant only) or the member's own
  /// communication-page toggle. Renew-variant outreach ignores this — see
  /// lib/outreach/recipients.ts. 'personal' (not 'internal'): the member reads/writes
  /// their own via their_own:personal; board/ops see it on the directory pill via
  /// everyones:personal. @sensitivity:personal
  emailSuppressed Boolean @default(false)

  /// @sensitivity:public
  householdId Int
  household   Household @relation(fields: [householdId], references: [id])

  /// True when this person is a lead of their own household ({@link householdId}).
  /// Single source of truth for leadership — supersedes the HouseholdLead join
  /// table, which stored a redundant householdId that could diverge (issue: the
  /// isLead check required lead.householdId === person.householdId). Cap of 2
  /// leads/household enforced at write, not in schema. @sensitivity:public
  isHouseholdLead Boolean @default(false)

  /// Provenance: when this record was merged into another Person, the surviving
  /// Person.id. Null == a live record. Set once by the merge route; the row is
  /// tombstoned, never deleted. Drives the double-merge CAS guard and the
  /// live-person filter (lib/person/filters.ts). @sensitivity:internal
  mergedIntoId Int?
  // Label is "PersonTombstone" because "PersonMerge" would collide with the model
  // of that name. Code-only: a named self-relation emits no SQL artifact — the
  // constraint is Person_mergedIntoId_fkey either way.
  mergedInto   Person?  @relation("PersonTombstone", fields: [mergedIntoId], references: [id])
  mergedFrom   Person[] @relation("PersonTombstone")

  /// Archive rows naming this person as the merge survivor (see PersonMerge).
  mergedArchive PersonMerge[] @relation("PersonMergeArchive")

  /// @sensitivity:personal
  allergies String?

  /// @deprecated legacy mirror column, kept in sync by write-through for existing
  /// readers (see PersonRole). PersonRole is the source of truth; dropped in the
  /// CONTRACT PR once those readers are ported to `roles:{some:{role:...}}`.
  /// @sensitivity:internal
  isSysadmin                Boolean @default(false)
  /// @deprecated legacy mirror column — see isSysadmin.
  /// @sensitivity:public
  isBoardMember             Boolean @default(false)
  /// @deprecated legacy mirror column — see isSysadmin.
  /// @sensitivity:internal
  isKeyholder               Boolean @default(false)
  /// @deprecated legacy mirror column — see isSysadmin.
  /// @sensitivity:internal
  isBackgroundCheckReviewer Boolean @default(false)

  /// Admits this person past the ops-stg access gate (middleware +
  /// authenticateRequest + resolveAccess) even though they are not a verified
  /// innovationtreehouse.org member — the escape hatch for an outside
  /// collaborator a sysadmin explicitly admits to staging. NOT one of the five
  /// PersonRole-backed flags in lib/roles.ts: it is sysadmin-settable only (a
  /// board member without isSysadmin may not grant it — see /api/roles), unlike
  /// the board-symmetric role matrix. Forced false whenever the household is
  /// DENIED (assignParticipantClaims), same as the role flags. Inert outside
  /// staging (isStaging()) — see lib/config.ts.
  /// @sensitivity:internal
  canAccessStaging Boolean @default(false)

  toolStatuses        ToolStatus[]
  bgAttestations      BackgroundCheckAttestation[] @relation("BgAttestations")
  bgAttestationsAsSubject BackgroundCheckAttestation[] @relation("BgAttestationSubject")
  personBgProcesses   OrgMembershipProcess[]       @relation("PersonBgSubject")
  intakeNoteAcks      OrgMembershipProcess[]       @relation("IntakeNoteReads")
  corporationLeads    CorporationLead[]
  corporationMembers  CorporationMember[]
  programVolunteers   ProgramVolunteer[]
  programParticipants ProgramParticipant[]
  programsLed         Program[]                    @relation("ProgramLeadMentor")
  instancesLed        ProgramInstance[]            @relation("InstanceLeadMentor")
  rsvps               RSVP[]
  rawBadgeLogs        RawBadgeLog[]
  presenceEvents      PresenceEvent[]
  visits              Visit[]
  eventsConfirmedBy   Event[]                      @relation("EventAttendanceConfirmer")

  trustedAdultRecordsAsAdult TrustedAdult[]       @relation("TrustedAdultPerson")
  trustedAdultsDisclosed      TrustedAdult[]       @relation("TrustedAdultDiscloser")
  trustedAdultReviewsDecided  TrustedAdultReview[] @relation("TrustedAdultDecider")

  // Source-of-truth role grants (see PersonRole). Two named relations because
  // Person is referenced twice (holder + granter) — same pattern as BgAttestations.
  roles        PersonRole[] @relation("PersonRoles")
  grantedRoles PersonRole[] @relation("RoleGrantedBy")

  // Household-lead lookups (a1): "leads of household X" runs on the hot paths
  // (check-in notification fan-out, nav badges, broken/unclaimed-household scans).
  // Person had no householdId index — the old HouseholdLead composite PK provided
  // one; this restores it, extended with isHouseholdLead so lead scans stay index-only.
  @@index([householdId, isHouseholdLead])
}

enum PersonRoleKind {
  SYSADMIN
  BOARD
  KEYHOLDER
  BG_REVIEWER
  OPERATIONS
  INVENTORY_MANAGER
}

/// Source of truth for role grants (expand phase of the boolean-column -> table
/// migration; see docs on the roles-foundation rework). The five session/JWT
/// booleans (isSysadmin...isOperations) are derived from this table
/// (src/lib/roles.ts rolesToFlags); four legacy Person columns stay as a
/// write-through mirror for existing readers (isOperations never had one).
model PersonRole {
  /// @sensitivity:internal
  personId    Int
  /// @sensitivity:internal
  role        PersonRoleKind
  /// @sensitivity:internal
  grantedAt   DateTime       @default(now())
  /// @sensitivity:internal
  grantedById Int?

  person    Person  @relation("PersonRoles",  fields: [personId],    references: [id], onDelete: Cascade)
  grantedBy Person? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([personId, role])
  // ponytail: no @@index([role]) — handful of rows, seq scan is free; add when the table grows.
}

model Tool {
  /// @sensitivity:public
  id           Int          @id @default(autoincrement())
  /// @sensitivity:public
  name         String
  /// @sensitivity:public
  safetyGuide  String?
  toolStatuses ToolStatus[]
}

model ToolStatus {
  /// @sensitivity:public
  personId Int
  /// @sensitivity:public
  toolId Int
  /// @sensitivity:member
  level  ToolLevel

  person Person @relation(fields: [personId], references: [id])
  tool Tool        @relation(fields: [toolId], references: [id])

  @@id([personId, toolId])
}

model Household {
  /// @sensitivity:public
  id      Int     @id @default(autoincrement())
  /// @sensitivity:public
  name    String
  /// Home address is strict-band intimate data. 'internal' (not 'personal')
  /// so it sits ABOVE every household-scoped grant that reaches program leads
  /// (their_program_households:pii/:personal — emergency contacts plus the
  /// parents' own contact details) and keyholders (keyholders:personal): they
  /// get people to call, never the family's address. Only
  /// board/sysadmin (everyones:internal) see it on registered routes; the
  /// household's own view is hand-shaped by the self-household routes.
  /// @sensitivity:internal
  line1      String?
  /// @sensitivity:internal
  line2      String?
  /// @sensitivity:internal
  city       String?
  /// @sensitivity:internal
  state      String?
  /// @sensitivity:internal
  postalCode String?

  /// Freeform "Anything else we should know?" captured at intake. Where a
  /// volunteer-only household types the note that tells a background-check
  /// reviewer to mark them volunteer. Stays 'pii' (NOT internal like the other
  /// narrative fields) because reviewers hold exactly everyones:pii on
  /// GET /api/membership/reviews and must read it. GUARD: what keeps it away
  /// from leads/keyholders is that Household binds NO scope but their_households
  /// (scopeBindings.ts) — a household-scoped token like
  /// their_program_households:pii resolves to nothing on a Household row, which
  /// is why GET /api/programs/[id] can grant one for the parents' Person rows
  /// without exposing this. Never bind Household to a program- or
  /// keyholder-scoped scope, or the narrative leaks with it.
  /// @sensitivity:pii
  intakeNotes String?

  householdMembers  Person[]
  orgMembership     OrgMembership?
  trustedAdults     TrustedAdult[]
  emergencyContacts EmergencyContact[]
}

/// An emergency contact for a household. Modeled as a separate entity (1 household
/// : many contacts) so external, non-family people can be linked. The invariant
/// "an emergency contact is not a member of the same household" is enforced in
/// application code (lib/emergencyContacts), not the database: a row is INVALID
/// when conflictParticipantId is set, meaning it collides with a household member.
model EmergencyContact {
  /// @sensitivity:public
  id          Int       @id @default(autoincrement())
  /// @sensitivity:public
  householdId Int
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  /// @sensitivity:personal
  name         String
  /// @sensitivity:personal
  phone        String
  /// @sensitivity:personal
  email        String?
  /// @sensitivity:personal
  relationship String?
  /// @sensitivity:public
  priority     Int     @default(0)

  // Normalized identity keys, used for the not-a-household-member check.
  /// @sensitivity:personal
  phoneDigits String
  /// @sensitivity:personal
  emailNorm   String?

  // Soft-conflict state. Null conflictParticipantId == a valid contact. When a
  // household member is found to be the same person as this contact, the id of
  // that member is recorded here (the row is kept for audit, flagged invalid).
  /// @sensitivity:internal
  conflictParticipantId Int?
  /// @sensitivity:internal
  conflictedAt          DateTime?

  /// @sensitivity:internal
  createdAt DateTime @default(now())
  /// @sensitivity:internal
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([phoneDigits])
}

enum OrgMembershipStatus {
  NONE
  ACTIVE
  REVOKED
  // Board denied this household membership. Unlike REVOKED (former member who keeps
  // app access but loses facility privileges), DENIED blocks login for every member
  // of the household — enforced in the auth jwt callback + middleware. A household
  // containing a board member cannot be DENIED; remove the board role first.
  DENIED
}

enum OrgMembershipProcessKind {
  INITIAL
  RENEWAL
  // Per-person background-check obligation (Phase 2). Not tied to a household
  // membership: orgMembershipId is null and subjectPersonId points at the person
  // being checked. Runs through the same two-reviewer gate as household checks.
  PERSON_BG
  // Per-person membership agreement for an adult child (#1224). Like PERSON_BG,
  // orgMembershipId is null and subjectPersonId is the signer. An 18+ child of the
  // signer is a legal adult and can't be bound by their parent's signature, so they
  // sign their own. Opens at PENDING_EXTERNAL_ACTION; the signature flips it to ACTIVE.
  PERSON_AGREEMENT
}

enum OrgMembershipProcessStatus {
  INTAKE
  PENDING_EXTERNAL_ACTION
  PENDING_BG_REVIEW
  PENDING_PAYMENT
  // Paid, but the background check has not yet cleared. The membership stays
  // INACTIVE here — it activates automatically once two reviewers approve (or a
  // prior valid check is detected). The BG review runs in parallel with payment,
  // so an applicant is never forced to wait on the long-tail check before paying.
  PENDING_BG_CLEARANCE
  ACTIVE
  BLOCKED
  PENDING_RENEWAL
  RENEWAL_PENDING_BG
  // Board-disposed abandoned application. Terminal, like ACTIVE/BLOCKED: it's a
  // status value (not a parallel flag) so "is this live?" stays a single
  // declarative status check. Who/when/from-phase live in the AuditLog row.
  ARCHIVED
}

enum AttestationResult {
  APPROVE
  REJECT
}

enum TrustedAdultOrigin {
  SELF_DISCLOSED
  STAFF_ENTERED
}

enum TrustedAdultReviewKind {
  INITIAL
  RENEWAL
  // Resubmission where the family CHANGED the trusted adult's facts (name/contact/
  // context) rather than reusing them (RENEWAL). The proposed edits ride on the
  // review (proposed* fields) and only promote onto the parent on approval, so a
  // still-live prior approval keeps its OWN facts for the front desk. The board's
  // prior-decision walk still yields "Renewal"/"Previously denied"; this only adds
  // the "— info updated" flag.
  MODIFIED
}

enum TrustedAdultReviewStatus {
  PENDING_BOARD_REVIEW
  PENDING_SUBJECT_ACTION
  APPROVED
  DENIED
  EXPIRED
  REVOKED
}

enum TrustedAdultDecisionKind {
  APPROVE
  DENY
  REQUEST_INFO
}

model OrgMembership {
  /// @sensitivity:public
  id          Int                 @id @default(autoincrement())
  /// Defaulted in the database to the UTC day. `now()` would cast in the
  /// connection's TimeZone, so the same instant would default to a different
  /// calendar day per session (docs/conventions.md, "A day is not a moment").
  /// @sensitivity:public
  memberSince DateTime            @default(dbgenerated("((now() AT TIME ZONE 'UTC'::text))::date")) @db.Date
  /// @sensitivity:public
  status      OrgMembershipStatus @default(NONE)
  /// @sensitivity:public
  isVolunteer Boolean             @default(false)

  /// @sensitivity:public
  householdId Int       @unique
  household   Household @relation(fields: [householdId], references: [id])

  processes OrgMembershipProcess[]

  @@index([status])
}

model OrgMembershipProcess {
  /// @sensitivity:public
  id                    Int                        @id @default(autoincrement())
  // Nullable since Phase 2: a PERSON_BG process is not tied to a household
  // membership (subjectPersonId is set instead). INITIAL/RENEWAL always set it.
  /// @sensitivity:public
  orgMembershipId       Int?
  // onDelete pinned to Restrict to keep the existing constraint (Prisma's default
  // for an optional relation is SetNull; the live FK is RESTRICT). Avoids drift.
  orgMembership         OrgMembership?             @relation(fields: [orgMembershipId], references: [id], onDelete: Restrict)
  // Set only for PERSON_BG processes — the person being background-checked
  // (participant, volunteer, or lead). Null for household INITIAL/RENEWAL.
  /// @sensitivity:public
  subjectPersonId       Int?
  subjectPerson         Person?                    @relation("PersonBgSubject", fields: [subjectPersonId], references: [id])
  /// @sensitivity:public
  kind                  OrgMembershipProcessKind
  /// @sensitivity:internal
  status                OrgMembershipProcessStatus
  /// The status ARCHIVED collapsed — captured by the archive write itself, since
  /// afterwards there is nothing left to read. Unarchive restores from this and
  /// clears it; null on every process that is not (or never was) archived.
  /// @sensitivity:internal
  archivedFromStatus    OrgMembershipProcessStatus?
  /// @sensitivity:internal
  stageEnteredAt        DateTime?               @default(now())
  /// @sensitivity:public
  createdAt             DateTime                @default(now())
  /// @sensitivity:internal
  zohoEnvelopeId        String?
  /// @sensitivity:internal
  zohoActionId          String?
  /// @sensitivity:internal
  contractSignedAt      DateTime?
  /// @sensitivity:internal
  bgConsentAt           DateTime?
  /// When the background-check requirement was satisfied for this cycle — either
  /// two reviewers approved, or a still-valid prior check was detected at intake.
  /// The single source of truth for "BG cleared", independent of the payment
  /// track; the membership only goes ACTIVE once this is set AND dues are paid.
  /// @sensitivity:internal
  bgClearedAt           DateTime?
  /// @sensitivity:internal
  shopifyDraftOrderId   String?
  /// @sensitivity:personal
  shopifyInvoiceUrl     String?
  /// @sensitivity:internal
  shopifyOrderId        String?
  /// @sensitivity:internal
  paidAt                DateTime?
  // The @map holds the physical column on its old name: most reads of this model
  // carry no select, so the previous release reads it through a rolling deploy's
  // drain window. Rename it in a later release (contract stage).
  /// @sensitivity:internal
  manualPaymentById     Int?                    @map("certifiedById")
  /// @sensitivity:internal
  certificationNote     String?
  /// Write-never as of the outreach engine (PR-2): the renewal sweep and the go-live
  /// bulk-open button no longer email, so nothing stamps this anymore. Kept (not
  /// dropped) because dropping a column is a destructive migration for no benefit —
  /// see lib/outreach for the only remaining send surface.
  /// @sensitivity:internal
  renewalReminderSentAt DateTime?
  /// @sensitivity:internal
  isPaymentPlanRequested Boolean @default(false)
  /// The household's intake note as submitted with this application. A snapshot, not
  /// a live read: the household may edit or clear Household.intakeNotes afterwards,
  /// and the audit question is what the applicant actually said. Disclosure-equivalent
  /// to the note itself, so it carries the note's tier; deleted with the process.
  /// @sensitivity:pii
  intakeNoteSnapshot    String?
  /// Who read the snapshot, and when. Staff-action audit metadata like every other
  /// actor/stamp pair on this model (manualPaymentById, bgClearedAt) — internal, not
  /// public: who has read a family's note is not a fact the row publishes.
  /// @sensitivity:internal
  noteAckById           Int?
  noteAckBy             Person?                 @relation("IntakeNoteReads", fields: [noteAckById], references: [id])
  /// @sensitivity:internal
  noteAckAt             DateTime?

  attestations BackgroundCheckAttestation[]

  @@index([orgMembershipId])
  @@index([status])
}

model BackgroundCheckAttestation {
  /// @sensitivity:public
  id              Int               @id @default(autoincrement())
  /// @sensitivity:public
  processId       Int
  process         OrgMembershipProcess @relation(fields: [processId], references: [id])
  /// @sensitivity:public
  reviewerId      Int
  reviewer        Person       @relation("BgAttestations", fields: [reviewerId], references: [id])
  /// The adult whose Averity check this attestation covers, read off the PDF by the
  /// reviewer. Null on PERSON_BG (the process already names its subject), on any
  /// REJECT (a rejection is whole-process), and on legacy household rows attested
  /// before per-adult subjects existed. Clearance stamps only named subjects, so a
  /// null one stamps nobody.
  /// @sensitivity:public
  subjectPersonId Int?
  subjectPerson   Person?      @relation("BgAttestationSubject", fields: [subjectPersonId], references: [id])
  /// @sensitivity:internal
  result          AttestationResult
  /// @sensitivity:internal
  note            String?
  /// @sensitivity:internal
  isMarkedVolunteer Boolean           @default(false)
  /// @sensitivity:public
  createdAt       DateTime          @default(now())

  /// Applied as raw SQL with `NULLS NOT DISTINCT` (see the migration): Postgres
  /// otherwise treats every (process, reviewer, NULL) row as distinct, which would
  /// let a PERSON_BG reviewer attest twice. Prisma cannot express that attribute, so
  /// a regenerated migration would silently weaken it.
  /// Named explicitly: the generated name would be 67 chars, past Postgres's 63-char
  /// identifier limit.
  @@unique([processId, reviewerId, subjectPersonId], map: "BgAttestation_processId_reviewerId_subjectPersonId_key")
}

model VolunteerDesignation {
  /// @sensitivity:public
  id          Int      @id @default(autoincrement())
  /// @sensitivity:pii
  email       String   @unique
  /// @sensitivity:internal
  createdById Int?
  /// @sensitivity:public
  createdAt   DateTime @default(now())
}

model BoardSettings {
  /// @sensitivity:public
  id                         Int       @id @default(1)
  // The @maps hold the physical columns on their old names: a bare
  // boardSettings.findUnique selects every column by name, so the previous release
  // reads these through a rolling deploy's drain window. Rename them in a later
  // release (contract stage).
  /// @sensitivity:public
  standardMembershipFeeCents Int       @default(0) @map("normalDuesCents")
  /// @sensitivity:public
  volunteerMembershipFeeCents Int      @default(0) @map("volunteerDuesCents")
  /// @sensitivity:public
  orgMembershipYearBoundary  DateTime? @db.Date
  /// Shopify variant ID of the membership product everyone checks out through.
  /// The "Pay with Shopify" link is built from it SERVER-SIDE (ensurePaymentLink
  /// in lib/membership/payment.ts) as
  /// https://<SHOPIFY_STORE_DOMAIN>/cart/<orgMembershipVariantId>:1; the client only
  /// receives the derived checkoutUrl, never this raw field — hence internal, not
  /// public (contrast Program.shopify*VariantId, which the browser builds from).
  /// @sensitivity:internal
  orgMembershipVariantId     String?
  /// Storefront URL of the membership product ("https://<store>/products/<handle>"),
  /// pasted by the board in membership settings. "Extract variant from URL" resolves
  /// orgMembershipVariantId from it server-side (lib/shopify.ts) — the Shopify admin
  /// UI hides the lone variant of a single-variant product, so the variant ID is not
  /// visible anywhere an admin could copy it from. The checkout link is always built
  /// from the variant ID above, never from this URL.
  /// @sensitivity:internal
  orgMembershipProductUrl    String?
  /// Discount code (created in Shopify by the board) appended to the checkout
  /// link for volunteer households so Shopify applies their discount.
  /// @sensitivity:internal
  volunteerDiscountCode      String?
  /// How long a background check stays valid, in months. 0 = not yet configured
  /// (the board must set the real Treehouse policy value before renewals re-check).
  /// @sensitivity:public
  bgRecheckMonths            Int       @default(0)
  /// DEV-INSTANCE-ONLY override for where contract signing requests go:
  /// 'debug' routes them to the in-app mock interstitial (/dev/zoho-sign) even
  /// when real Zoho creds are set; 'zoho' or NULL uses whatever the env
  /// dictates (real client when creds are set). Only ever read when
  /// CHECKIN_ENV=dev — hard fuse in lib/membership/contract/signingTarget.ts;
  /// prod and local never consult it.
  /// @sensitivity:internal
  devSigningTarget           String?
  /// Overrides the EMAIL_FROM env value as the Resend sender on every outbound
  /// email when set. Must be on a Resend-verified domain or all mail bounces —
  /// hence the confirm-to-edit guard in the settings UI. Null = fall back to
  /// EMAIL_FROM; with that unset too, sendEmail refuses to send.
  /// @sensitivity:public
  emailFromAddress           String?
  /// Reply-To header set on every outbound email when set (the From address is a
  /// no-reply, so this routes replies to a real inbox). Null = no Reply-To (replies
  /// go to From). Need not be on the sending domain.
  /// @sensitivity:public
  emailReplyToAddress        String?
  /// Where a new scholarship / payment-plan request is announced (the "Scholarship
  /// Review Team"). Comma-separated list of one or more addresses, each a bare
  /// address or "Name <addr@domain>" — same shape as emailReplyToAddress. NULL =
  /// fall back to emailing every board member (the board IS the review team until
  /// this is configured).
  /// @sensitivity:internal
  scholarshipNotifyEmail     String?
  /// Subject line for the scholarship / payment-plan request ACK — the applicant's
  /// only automatic email (scholarshipEmails.ts). NULL or blank = the default copy
  /// in lib/scholarshipEmails.ts. Set on Settings → Email, same section as
  /// scholarshipNotifyEmail. @sensitivity:internal
  scholarshipAckSubject      String?
  /// ACK body for a membership-dues request (POST /api/membership/request-payment-plan).
  /// Plain text: rendered by HTML-escaping then splitting into `<p>` paragraphs — never
  /// interpreted as HTML (see scholarshipAckProgramBody re: the outreach preview XSS
  /// history this deliberately avoids). NULL/blank = the default copy.
  /// @sensitivity:internal
  scholarshipAckMembershipBody String?
  /// ACK body for a program request (POST /api/programs/[id]/request-payment-plan).
  /// Same plain-text rendering as scholarshipAckMembershipBody, plus one token,
  /// `{{programName}}`. Ignored on the Shopify-seat-hold-failed branch, which always
  /// sends its own hard-coded operational-incident copy (the subject above still
  /// applies). NULL/blank = the default copy. @sensitivity:internal
  scholarshipAckProgramBody String?
  /// Opening-of-renewals campaign template (settings/outreach). Board/sysadmin/ops
  /// editable; four tokens only ({{name}} {{deadline}} {{actionWord}} {{actionLink}}),
  /// validated on save. @sensitivity:internal
  outreachOpeningSubject     String?
  /// @sensitivity:internal
  outreachOpeningBody        String?
  /// Reminder campaign template (settings/outreach). Same token set as
  /// outreachOpeningSubject/Body. @sensitivity:internal
  outreachReminderSubject    String?
  /// @sensitivity:internal
  outreachReminderBody       String?
  /// @sensitivity:internal
  shopifyOrgMembershipProductId String?
  /// @sensitivity:internal
