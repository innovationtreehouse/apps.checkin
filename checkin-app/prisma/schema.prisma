  id            Int      @id @default(autoincrement())
  /// @sensitivity:internal
  personId Int
  /// @sensitivity:personal
  timestamp     DateTime @default(now())
  /// @sensitivity:personal
  location      String?
  /// @sensitivity:internal
  clientEventId String?  @unique // kiosk replay idempotency key; NULL for legacy/web writers
  /// @sensitivity:internal
  reviewReason  String?          // set when a stale/out-of-order replay is parked instead of toggled

  /// Review stamp for a parked row (§2 D7): null while it still needs a human.
  /// `reviewReason != null AND reviewedAt = null` IS the unsynced-scans queue.
  /// @sensitivity:internal
  reviewedAt    DateTime?
  /// Actor who dismissed the row. Plain Int like Visit.deletedById — the audit
  /// trail is the provenance, and a relation would need a Person back-link for
  /// nothing this reads. @sensitivity:internal
  reviewedBy    Int?

  person Person @relation(fields: [personId], references: [id])

  @@index([personId, timestamp]) // Double-badge detection in /api/scan
}

/// Direction the producing surface displayed (invariant 5). Visits project
/// from this log; they do not re-toggle from live state.
enum PresenceDirection {
  IN
  OUT
}

/// Stage-2 substrate (docs/rules/attendance-checkin.md, kiosk resilience):
/// every presence-affecting surface appends an intent-carrying event; Visits
/// project from the ordered log.
/// Expand-only — old writers never touch this table.
model PresenceEvent {
  /// @sensitivity:internal
  id             Int               @id @default(autoincrement())
  /// @sensitivity:public
  personId       Int
  /// @sensitivity:personal
  occurredAt     DateTime
  /// @sensitivity:internal
  direction      PresenceDirection
  /// @sensitivity:public
  source         VisitSource
  /// @sensitivity:internal
  clientEventId  String?           @unique
  /// M2 classify output: PROJECTED | PARKED_* | CONFLICT_*. String, not an
  /// enum, so new park reasons do not need ADD VALUE. @sensitivity:internal
  classification String?
  /// @sensitivity:internal
  clockSuspect   Boolean           @default(false)
  /// Visit this event projected into, when classification is PROJECTED.
  /// Plain Int (no FK): a tombstoned visit must not cascade-delete the log.
  /// @sensitivity:internal
  visitId        Int?
  /// @sensitivity:internal
  createdAt      DateTime          @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, occurredAt])
  @@index([classification, occurredAt])
}

model Visit {
  /// @sensitivity:public
  id                Int       @id @default(autoincrement())
  /// @sensitivity:public
  personId          Int
  /// @sensitivity:personal
  arrivedAt         DateTime
  /// @sensitivity:personal
  departedAt        DateTime?
  /// @sensitivity:public
  arrivedVia        VisitSource?
  /// @sensitivity:public
  departedVia       VisitSource?
  /// @sensitivity:public
  associatedEventId Int?

  /// Tombstone: a deleted visit keeps its row (reviewable + reversible); every
  /// user-facing read filters through LIVE_VISIT (lib/visit/filters.ts).
  /// Null == live. @sensitivity:internal
  deletedAt         DateTime?
  /// Actor who tombstoned the row; the audit trail is the full provenance.
  /// @sensitivity:internal
  deletedById       Int?

  /// When the kiosk last showed this keyholder the "others are still here"
  /// force-close warning. Audit stamp only — the confirm is the token below.
  /// @sensitivity:internal
  forceCloseWarnedAt DateTime?

  /// Confirm token minted with that warning and returned to the kiosk. Only a
  /// scan echoing it force-closes, so an ordinary double-tap cannot; validity
  /// is by issuance, not elapsed time, so a confirm queued through an outage
  /// still closes when it lands (§5.23a). @sensitivity:internal
  forceCloseToken   String?

  /// When the kiosk last showed this person the "the room drops below two
  /// supervising adults" warning (#1436). Its own stamp, not forceCloseWarnedAt:
  /// the keyholder close-guard is a separate interrupt that can be pending at the
  /// same time.
  /// @sensitivity:internal
  supervisionWarnedAt DateTime?

  person Person @relation(fields: [personId], references: [id])
  event  Event?      @relation(fields: [associatedEventId], references: [id])

  @@index([personId, departedAt]) // Active visits lookup in /api/scan
  // Partial unique index "Visit_one_open_per_participant" — at most one open,
  // live visit (departedAt IS NULL AND deletedAt IS NULL) per participant.
  // Prisma's DSL can't express a partial unique index, so it lives in raw SQL
  // (recreated in 20260726120000_visit_tombstone). DB-level backstop against
  // double check-in races.
}

model AuditLog {
  /// @sensitivity:internal
  id                      Int         @id @default(autoincrement())
  /// @sensitivity:internal
  timestamp               DateTime    @default(now())
  /// @sensitivity:internal
  actorId                 Int
  /// Which automated path wrote this row (`cron:nightly`, `webhook:shopify`, …)
  /// when actorId is the system sentinel; null for a person's own action.
  /// @sensitivity:internal
  actorSystem             String?
  /// @sensitivity:internal
  action                  AuditAction
  /// @sensitivity:internal
  tableName               String
  /// @sensitivity:internal
  affectedEntityId        Int
  /// @sensitivity:internal
  secondaryAffectedEntity Int?
  /// @sensitivity:internal
  oldData                 Json?
  /// @sensitivity:internal
  newData                 Json?

  @@index([actorId])
  @@index([actorSystem])
  // The corrections review reads one table over a time window, newest first.
  // Neither actor index serves that; without this it is a full scan of every
  // audit row the org has ever written.
  @@index([tableName, timestamp])
}

model Account {
  /// @sensitivity:internal
