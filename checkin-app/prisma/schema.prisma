// Program → Instance → Event, PHASE 1 (additive tier + 1:1 backfill; nothing
// reads it yet). See docs/designs/PROGRAM_INSTANCE_RESTRUCTURE.md §3/§7 P1.
// The offering columns are mirrored here so a later phase can repoint the child
// FKs (programId → instanceId) as a pure RENAME off the id-aliased backfill.
// ponytail: two offering columns the design lists are deliberately deferred to a
// later phase — leadMentorNotificationSettings (its `personal` tier would make
// this model sensitive-and-scopable, forcing a scopeBindings entry that the
// design itself only wants in the Phase 3 claim swap) and the retiring
// @ignore'd shopify org/non-org variant pair. Nothing reads either in Phase 1;
// the data stays on Program until Phase 5 drops it, so add them with their
// readers/binding later.
model ProgramInstance {
  /// @sensitivity:public
  id               Int              @id @default(autoincrement())
  /// @sensitivity:public
  programId        Int
  program          Program          @relation(fields: [programId], references: [id])
  /// Run label, e.g. "Fall 2026". Backfill seeds it from the parent name.
  /// @sensitivity:public
  name             String
  /// @sensitivity:public
  leadMentorId     Int?
  leadMentor       Person?          @relation("InstanceLeadMentor", fields: [leadMentorId], references: [id])
  /// @sensitivity:public
  startAt          DateTime?        @db.Date
  /// @sensitivity:public
  endAt            DateTime?        @db.Date
  /// @sensitivity:public
  phase            ProgramPhase     @default(PLANNING)
  /// @sensitivity:public
  enrollmentStatus EnrollmentStatus @default(CLOSED)
  /// @sensitivity:public
  maxParticipants  Int?
  /// Narrowing override (§3a): NULL = inherit the definition. A non-null value
  /// may only make the band STRICTER — enforced at write time in a later phase.
  /// @sensitivity:public
  minAge           Int?
  /// @sensitivity:public
  maxAge           Int?
  /// @sensitivity:public
  orgMemberOnly    Boolean?
  /// @sensitivity:public
  shopifyProductId String?
  /// @sensitivity:public
  shopifyVariantId String?

  events Event[]
}

